DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=15"
# connection_limit=1: SQLite kennt nur einen Schreiber – so werden parallele Scans sauber nacheinander ausgeführt

# Beide Werte lang und zufällig: openssl rand -base64 48
AUTH_SECRET=""        # signiert die Händler-Session
QR_SIGNING_SECRET=""  # Basis für die Kunden-QR-Signatur

# Öffentliche Basis-URL (für Karten-Links und Wallet-Pässe)
APP_URL="http://localhost:3000"

# Sekunden, in denen dieselbe Karte nicht erneut gestempelt werden kann
STAMP_COOLDOWN_SECONDS=30

# Google Wallet (optional) – Service-Account aus der Google Wallet Console
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""   # PEM, Zeilenumbrüche als \n

# Apple Wallet (optional, braucht kostenpflichtiges Developer-Zertifikat)
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
